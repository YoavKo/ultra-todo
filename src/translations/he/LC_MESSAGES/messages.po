msgstr "עדכון"

msgid "Commit task changes and push"
msgstr "commit לשינויי המשימות ו-push"

msgid "Save work"
msgstr "שמירת עבודה"

msgid "Commit message"
msgstr "הודעת commit"

msgid "Cancel"
msgstr "ביטול"

msgid "Commit & push"
msgstr "commit ו-push"

#, python-format
msgid "%(n)s changes"
msgstr "%(n)s שינויים"

msgid "No uncommitted changes; unpushed commits will be pushed."
msgstr "אין שינויים שלא נשמרו; commits שטרם נדחפו יידחפו."

msgid "Update with rebase"
msgstr "עדכון עם rebase"

