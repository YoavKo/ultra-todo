msgstr "פרסום הענף"

msgid "no upstream"
msgstr "ללא upstream"

msgid "Working…"
msgstr "עובד…"

msgid "Delete this? This cannot be undone."
msgstr "למחוק? לא ניתן לבטל פעולה זו."

msgid "Error"
msgstr "שגיאה"

msgid "Blocked by"
msgstr "חסום ע״י"

msgid "Back"
msgstr "חזרה"

msgid "ID"
msgstr "מזהה"

msgid "Title"
msgstr "כותרת"

msgid "Status"
msgstr "סטטוס"

msgid "No tasks match."
msgstr "אין משימות מתאימות."

msgid "optional, generated if empty"
msgstr "אופציונלי, ייווצר אוטומטית אם ריק"

msgid "Content language"
msgstr "שפת התוכן"

msgid "Auto-detect"
msgstr "זיהוי אוטומטי"

msgid "Remove"
msgstr "הסרה"

msgid "Add tag, press Enter"
msgstr "הוסיפו תגית ולחצו Enter"

msgid "Description"
msgstr "תיאור"

msgid "Create"
msgstr "יצירה"

msgid "Save"
msgstr "שמירה"

