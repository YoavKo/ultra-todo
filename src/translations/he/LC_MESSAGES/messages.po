msgid "To do"
msgstr "לביצוע"

msgid "In progress"
msgstr "בתהליך"

msgid "Done"
msgstr "הושלם"

msgid "Blocked"
msgstr "חסום"

msgid "This branch has no upstream. Use “Save work” to publish it first."
msgstr "לענף הזה אין upstream. השתמשו ב„שמירת עבודה” כדי לפרסם אותו קודם."

msgid "This repository has no remote configured."
msgstr "למאגר הזה לא מוגדר remote."

msgid "Your branch and the remote have diverged. Update with rebase?"
msgstr "הענף שלך והשרת התפצלו. לעדכן עם rebase?"

msgid "Update stopped: the same files changed on both sides. Nothing was changed; resolve these files in git:"
msgstr "העדכון נעצר: אותם קבצים שונו בשני הצדדים. שום דבר לא שונה; יש לפתור את הקבצים האלה ב-git:"

msgid "Updated, but re-applying your local edits conflicted. Your edits are kept in git stash. Files:"
msgstr "העדכון בוצע, אך החלת השינויים המקומיים שלך נתקלה בקונפליקט. השינויים שמורים ב-git stash. קבצים:"

msgid "The remote has newer changes. Click “Update” first, then save again."
msgstr "בשרת יש שינויים חדשים יותר. לחצו קודם על „עדכון” ואז שמרו שוב."

msgid "Push failed."
msgstr "ה-push נכשל."

msgid "Update failed."
msgstr "העדכון נכשל."

msgid "Invalid or missing CSRF token. Reload the page."
msgstr "אסימון CSRF חסר או שגוי. טענו את הדף מחדש."

#, python-format
msgid "Dependency cycle: %(cycle)s"
msgstr "מעגל תלויות: %(cycle)s"

msgid "Only the author can change this comment."
msgstr "רק מחבר/ת התגובה יכול/ה לשנות אותה."

msgid "Not found"
msgstr "לא נמצא"

#, python-format
msgid "Not found: %(what)s"
msgstr "לא נמצא: %(what)s"

#, python-format
msgid "Saved, but auto-commit failed: %(err)s"
msgstr "נשמר, אך ה-commit האוטומטי נכשל: %(err)s"

#, python-format
msgid "Task %(id)s created."
msgstr "המשימה %(id)s נוצרה."

msgid "Task saved."
msgstr "המשימה נשמרה."

#, python-format
msgid "Task %(id)s deleted."
msgstr "המשימה %(id)s נמחקה."

msgid "Updated. Index rebuilt."
msgstr "עודכן. האינדקס נבנה מחדש."

msgid "Already up to date."
msgstr "הכול כבר מעודכן."

#, python-format
msgid "Updated: %(a)d added, %(u)d changed, %(d)d removed, %(c)d comments."
msgstr "עודכן: %(a)d נוספו, %(u)d שונו, %(d)d הוסרו, %(c)d תגובות."

msgid "Committed and pushed."
msgstr "בוצע commit ו-push."

msgid "Pushed."
msgstr "בוצע push."

msgid "Committed."
msgstr "בוצע commit."

msgid "Nothing to save."
msgstr "אין מה לשמור."

msgid "Search tasks and comments…"
msgstr "חיפוש במשימות ובתגובות…"

msgid "Assignee"
msgstr "אחראי/ת"

msgid "All assignees"
msgstr "כל האחראים"

msgid "Match any tag"
msgstr "התאמה לאחת התגיות"

msgid "Filter"
msgstr "סינון"

msgid "Clear"
msgstr "ניקוי"

#, python-format
msgid "%(num)d task"
msgid_plural "%(num)d tasks"
msgstr[0] "משימה אחת"
msgstr[1] "%(num)d משימות"

